<Project>
  <Target Name="PrintPackageVersions" AfterTargets="Restore" Condition="'$(PrintPackageVersions)' == 'true'">
    <Message Importance="high" Text="PKG-DIRECT: %(PackageReference.Identity) -> %(PackageReference.Version)" />
    <Exec Condition="'$(OS)' == 'Windows_NT' and Exists('$(BaseIntermediateOutputPath)project.assets.json')"
          IgnoreExitCode="true"
          Command="powershell -NoProfile -Command &quot;$a = Get-Content '$(BaseIntermediateOutputPath)project.assets.json' -Raw | ConvertFrom-Json; $a.libraries.PSObject.Properties.Name | Sort-Object -Unique | ForEach-Object { Write-Output ('PKG-ALL: ' + $_) }&quot;" />
  </Target>
</Project>
